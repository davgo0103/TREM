{
  "name": "tremv",
  "version": "7.0.0",
  "description": "Taiwan Real-time Earthquake Monitoring Variety ( 臺灣即時地震監測變體 )",
  "main": "main.js",
  "homepage": "https://exptech.com.tw/",
  "author": "ExpTechTW <ExpTech.tw@gmail.com>",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --key",
    "dist": "electron-builder -p never",
    "dist_x64": "electron-builder --x64 -p never -c macos_x64.json",
    "dist_arm64": "electron-builder --arm64 -p never -c macos_arm64.json",
    "lint": "eslint --ext .js js/"
  },
  "build": {
    "productName": "TREMV",
    "appId": "tw.exptech.tremv",
    "asar": true,
    "asarUnpack": [
      "./audio",
      "./package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "TREM.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "TREM.icns",
      "category": "Development",
      "maintainer": "ExpTechTW"
    },
    "directories": {
      "buildResources": "resources",
      "output": "dev"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yayacat/TREM.git"
  },
  "keywords": [],
  "license": "AGPL-3.0",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@material/material-color-utilities": "0.2.0",
    "chokidar": "^4.0.3",
    "echarts": "^5.6.0",
    "electron-log": "5.4.1",
    "electron-updater": "^6.8.11",
    "expose-gc": "^1.0.0",
    "jquery": "3.7.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-edgebuffer": "^1.0.7",
    "leaflet-geojson-vt": "github:ExpTechTW/leaflet-geojson-vt",
    "speak-tts": "^2.0.8",
    "tinycolor2": "1.6.0",
    "ws": "^8.18.3"
  }
}
